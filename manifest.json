{
  "manifest_version": 3,
  "name": "Feed Focus Lens",
  "version": "1.0.0",
  "description": "Organisez et filtrez votre expérience LinkedIn en vous concentrant sur des profils et contenus spécifiques",
  "permissions": ["activeTab", "storage", "scripting", "contextMenus", "tabs"],
  "host_permissions": ["*://*.linkedin.com/*", "https://feed-focus.vercel.app/*"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["*://*.linkedin.com/*"]
    }
  ]
}
